{
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:next": "npm --prefix next-app run dev",
    "build:next": "npm --prefix next-app run build",
    "start:next": "npm --prefix next-app run start",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "start:backend": "npm --workspace backend run start"
  },
  "dependencies": {
    "nodemailer": "^7.0.12"
  },
  "devDependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
