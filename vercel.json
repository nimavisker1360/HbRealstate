{
  "framework": "nextjs",
  "installCommand": "npm install && npm --prefix next-app install",
  "buildCommand": "npm run build:next && node -e \"require('fs').cpSync('next-app/.next','.next',{recursive:true,force:true})\"",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hbrealstate.com" }],
      "destination": "https://www.hbrealstate.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/user/:path*", "destination": "/api/index.js" },
    { "source": "/api/residency/:path*", "destination": "/api/index.js" },
    { "source": "/api/consultant/:path*", "destination": "/api/index.js" },
    { "source": "/api/email/:path*", "destination": "/api/index.js" },
    { "source": "/api/blog/:path*", "destination": "/api/index.js" },
    { "source": "/api/housing-sales/:path*", "destination": "/api/index.js" },
    { "source": "/api/testimonial/:path*", "destination": "/api/index.js" },
    { "source": "/api/assistant/:path*", "destination": "/api/index.js" },
    { "source": "/api/sitemap.xml", "destination": "/api/index.js" }
  ]
}
